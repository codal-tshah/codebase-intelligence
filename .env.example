# Copy to .env (never commit it). All variables are optional in local mode.

# --- Runtime -------------------------------------------------------------
# local  = trusted single user (default)
# server = shared host: requires CI_API_KEY and CI_PROJECT_ROOTS
CI_MODE=local
CI_DATA_DIR=~/.codebase-intelligence
# Server mode: API clients send  X-API-Key: <key>  (or Authorization: Bearer <key>)
# CI_API_KEY=
# Server mode: only these directories may be indexed (comma-separated)
# CI_PROJECT_ROOTS=/srv/repos
CI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Restrict analyzers, e.g. python,typescript
# CI_ANALYZERS=

# --- Logging -------------------------------------------------------------
CI_LOG_LEVEL=INFO
CI_LOG_JSON=0

# --- LLM (optional; without it the assistant answers from graph tools) ----
ALLOW_LLM=false
LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
# Self-hosted OpenAI-compatible endpoint keeps code on-prem:
# LLM_API_BASE=http://localhost:11434
